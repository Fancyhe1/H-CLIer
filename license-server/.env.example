# Turso Database (production)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Admin API Key (for generating invitation codes)
ADMIN_API_KEY=your-admin-secret-key

# Signature Secret (for generating validation signatures)
SIGNATURE_SECRET=your-signature-secret

# Server Port (local development)
PORT=3000
